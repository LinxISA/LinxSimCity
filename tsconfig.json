{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "eslint.config.js",
    "scripts/**/*.mjs",
    "scripts/**/*.test.ts",
    "vitest.config.ts",
    "vitest.workspace.ts",
    "packages/**/*.test.ts",
    "tests/**/*.test.ts"
  ]
}
