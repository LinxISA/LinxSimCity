{
  "name": "linxsimcity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "node scripts/run-workspaces.mjs build",
    "test": "vitest run",
    "typecheck": "node scripts/run-workspaces.mjs typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.3",
    "eslint": "10.8.1",
    "jsdom": "29.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
