{
  "name": "@linxsimcity/scene-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build --workspace @linxsimcity/topology && npm run build --workspace @linxsimcity/trace-runtime",
    "build": "tsc --project tsconfig.json",
    "pretypecheck": "npm run build --workspace @linxsimcity/topology && npm run build --workspace @linxsimcity/trace-runtime",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@linxsimcity/topology": "0.1.0",
    "@linxsimcity/trace-runtime": "0.1.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/three": "0.185.4"
  }
}
