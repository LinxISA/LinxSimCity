            "name": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "required": ["name", "sha256"],
          "additionalProperties": false
        },
        "timeDomains": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "unit": { "type": "string", "const": "cycle" },
              "tickRatio": {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "denominator": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": ["numerator", "denominator"],
                "additionalProperties": false
              }
            },
            "required": ["id", "unit", "tickRatio"],
            "additionalProperties": false
          }
        },
        "window": {
          "type": "object",
          "properties": {
            "firstCycle": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "lastCycle": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$"
            },
            "startsFromReset": { "type": "boolean" },
            "complete": { "type": "boolean" }
          },
          "required": [
            "firstCycle",
            "lastCycle",
            "startsFromReset",
            "complete"
          ],
          "additionalProperties": false
        },
        "eventCount": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
        "capabilities": {
          "type": "array",
